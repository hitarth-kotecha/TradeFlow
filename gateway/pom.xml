<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tradeflow</groupId>
        <artifactId>tradeflow-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>gateway</artifactId>
    <name>TradeFlow Gateway</name>
    <description>The runnable application: REST controllers, security, and the Spring Boot entrypoint</description>

    <dependencies>
        <!-- Our shared kernel. Version comes from the parent's dependencyManagement. -->
        <dependency>
            <groupId>com.tradeflow</groupId>
            <artifactId>common</artifactId>
        </dependency>

        <!-- Trade ingestion module: its entities/services are component-scanned by the app. -->
        <dependency>
            <groupId>com.tradeflow</groupId>
            <artifactId>trade-ingestion</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Risk engine (Kafka consumer + position logic) and its position-store, part of the app. -->
        <dependency>
            <groupId>com.tradeflow</groupId>
            <artifactId>risk-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tradeflow</groupId>
            <artifactId>position-store</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Alert service (risk.breached consumer + alert persistence), part of the app. -->
        <dependency>
            <groupId>com.tradeflow</groupId>
            <artifactId>alert-service</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Reporting (P&L snapshots + batch), part of the app. -->
        <dependency>
            <groupId>com.tradeflow</groupId>
            <artifactId>reporting</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Embedded Tomcat + Spring MVC + JSON. Makes this a web app. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Operability: /actuator/health, /metrics, etc. (OBS-02). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- JPA/Hibernate over a HikariCP datasource. Entities map to the Flyway-owned schema. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation (@Valid, @NotNull, ...) for request DTOs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JWT (HS256) issue/verify. api at compile time; impl + jackson at runtime. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Full Spring Security: filter chain, method security, and (transitively) BCrypt. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway: schema-as-code, runs migrations on startup (spec §18.2). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Exposes metrics in Prometheus format at /actuator/prometheus (OBS-02). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Auto-generated OpenAPI doc + Swagger UI at /swagger-ui.html (NFR-DOC-01). Version from parent. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- WebSocket + STOMP broker for real-time alerts (FR-ALERT-02). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: real Postgres in Docker for integration tests (NFR-TEST-02). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Repackage into an executable fat jar. ONLY the gateway is repackaged,
                 because it is the single deployable for the modular monolith. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
