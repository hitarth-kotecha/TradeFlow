<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Inherit Spring Boot's curated dependency versions (the BOM) and plugin setup.
         This is what lets child modules declare starters without writing version numbers. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- look the parent up from Maven Central, not a local dir -->
    </parent>

    <groupId>com.tradeflow</groupId>
    <artifactId>tradeflow-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging> <!-- aggregator only: no source code lives here -->

    <name>TradeFlow Parent</name>
    <description>Multi-tenant trading risk engine — modular monolith on Java 25 + Project Loom</description>

    <properties>
        <!-- Spring Boot's parent reads java.version to set the compiler's release level. -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jjwt.version>0.13.0</jjwt.version>
        <!-- Populated by JaCoCo's prepare-agent; kept separate from the preview flag so both compose. -->
        <jacocoArgLine/>
    </properties>

    <!-- The reactor: Maven reads these, works out the dependency order, and builds them together.
         Listed common-first for readability; Maven re-sorts by the actual dependency graph anyway. -->
    <modules>
        <module>common</module>
        <module>position-store</module>
        <module>trade-ingestion</module>
        <module>risk-engine</module>
        <module>alert-service</module>
        <module>reporting</module>
        <module>gateway</module>
    </modules>

    <!-- Price list, not a shopping cart: pins the version of our internal 'common' module
         in ONE place so the six modules that depend on it never repeat the version. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.tradeflow</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- springdoc is NOT in Spring Boot's BOM, so we pin its version here ourselves. -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>2.8.17</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!-- Configuration here is inherited by every child module. Define the build once. -->
        <plugins>
            <!-- Compile against Java 25 with preview features ON (needed for StructuredTaskScope, JEP 505). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Preview-compiled classes also require the flag at RUNTIME, including in tests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- @{jacocoArgLine} is late-resolved to the coverage agent; UTC so Testcontainers
                         DB connections don't inherit a host tz alias Postgres rejects. -->
                    <argLine>@{jacocoArgLine} --enable-preview -Duser.timezone=UTC</argLine>
                </configuration>
            </plugin>

            <!-- Coverage: prepare the agent (into jacocoArgLine) and emit a report every test run.
                 The 80% gate itself is enforced only in risk-engine + position-store (NFR-TEST-01). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <propertyName>jacocoArgLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
