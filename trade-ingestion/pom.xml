<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tradeflow</groupId>
        <artifactId>tradeflow-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>trade-ingestion</artifactId>
    <name>TradeFlow Trade Ingestion</name>
    <description>Validate and persist trades, write the outbox, relay TradeSubmittedEvent (FR-TRADE-*)</description>

    <dependencies>
        <dependency>
            <groupId>com.tradeflow</groupId>
            <artifactId>common</artifactId>
        </dependency>

        <!-- JPA annotations + Spring Data for the trade & outbox entities. The gateway app
             (which depends on this module) provides the actual datasource/autoconfig. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- To serialize the event into the outbox row's JSONB payload. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Kafka producer for the outbox relay. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
    </dependencies>
</project>
