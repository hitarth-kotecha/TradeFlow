<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tradeflow</groupId>
        <artifactId>tradeflow-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>reporting</artifactId>
    <name>TradeFlow Reporting</name>
    <description>Spring Batch P&amp;L job with structured-concurrency fan-out, report and summary APIs (FR-PNL-*, FR-SUM-*)</description>

    <dependencies>
        <dependency>
            <groupId>com.tradeflow</groupId>
            <artifactId>common</artifactId>
        </dependency>

        <!-- JPA for the pnl_snapshots entity (also provides JdbcTemplate for tenant/instrument lookups). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Batch for the P&L snapshot job (FR-PNL-01). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
        </dependency>

        <!-- Read trades to fold into P&L. -->
        <dependency>
            <groupId>com.tradeflow</groupId>
            <artifactId>trade-ingestion</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
